{% comment %}
  Renders a list of product's price (regular, sale)

  Accepts:
  - product: {Object} Product Liquid object (optional)
  - use_variant: {Boolean} Renders selected or first variant price instead of overall product pricing (optional)
  - pdp: {Boolean} Escala de página de produto (preço maior) em vez da de prateleira (optional)
  Usage:
  {% render 'price', product: product %}

  `block` no elemento não é decorativo: <price-component> é custom element e
  não tem regra de CSS no tema, então sem display declarado ele seria inline.

  Não renderiza parcelamento: o tema não tem os dados para calculá-lo. Ver
  docs/adr/0008-o-tema-nao-calcula-dinheiro-que-o-checkout-nao-produz.md — a
  informação de parcelamento é texto do lojista, no bloco `payment_icons`.
{% endcomment %}
{%- liquid
  if use_variant
    assign target = product.selected_or_first_available_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999
  assign money_price = price | money
-%}

<price-component
  class="block"
  id="{{ product.id }}"
>
  <div class="flex gap-2 items-baseline">
    <span class="listing-price line-through {% if compare_at_price > price %}{% else %} hidden {%- endif -%} {% if pdp %} text-base {% else %} text-sm {% endif %} text-foreground/40 font-light">
      {{- compare_at_price | money -}}
    </span>
    <span class="selling-price {% if pdp %} text-2xl font-medium tracking-title {% else %} text-sm {% endif %} text-foreground">
      {{ money_price }}
    </span>
  </div>
</price-component>
