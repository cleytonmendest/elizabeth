{%- comment -%}
  Indicador de status de estoque do bloco de produto.

  Parâmetros:
  - block: bloco com configurações (obrigatório)
  - product: produto atual (obrigatório)
  - current_variant: variante selecionada (opcional, usa a primeira disponível)

  O aviso acompanha a troca de variante (#157). O script abaixo escutava no
  `document`, onde a troca feita pela cliente nunca chega — o evento sai do
  [product-context] e não borbulha —, e o aviso ficava para sempre com o
  estoque da variante com que a página abriu. Agora ele escuta no contexto
  DESTE produto, e nada que ele lê sai de fora deste bloco.

  A decisão (qual aviso, qual texto) mora em inventory-status-aviso.liquid, e
  o script não calcula nada: ele troca o conteúdo pelo modelo do estado e
  põe o texto que o Liquid já escreveu para aquela variante. O contêiner
  existe sempre, escondido quando a variante não tem aviso: sem isso, abrir
  numa variante sem aviso deixava o script sem lugar onde escrever.
{%- endcomment -%}

{%- liquid
  assign current_variant = current_variant | default: product.selected_or_first_available_variant
  assign limite = block.settings.inventory_threshold | default: 10
  # `allow_false`: sem ele o `default` troca o `false` do checkbox por `true`,
  # e "mostrar quantidade" desligado não desligava nada.
  assign mostra_quantidade = block.settings.show_inventory_quantity | default: true, allow_false: true
  assign estilo = block.settings.text_style | default: 'body'
  assign estados = 'baixo,disponivel,esgotado' | split: ','
-%}

{%- capture aviso_inicial -%}
  {%- render 'inventory-status-aviso',
    variante: current_variant,
    limite: limite,
    mostra_quantidade: mostra_quantidade,
    estilo: estilo
  -%}
{%- endcapture -%}

<div
  class="product-inventory-status"
  {{ block.shopify_attributes }}
  data-inventory-status
  {% if aviso_inicial == '' %}
    hidden
  {% endif %}
>
  <div data-estoque-aviso>{{ aviso_inicial }}</div>

  {%- unless product.has_only_default_variant -%}
    {%- for estado in estados -%}
      <template data-estoque-modelo="{{ estado }}">
        {%- render 'inventory-status-aviso', modelo: estado, estilo: estilo -%}
      </template>
    {%- endfor -%}

    {%- capture mapa -%}
      {%- assign separador = '' -%}
      {%- for variante in product.variants -%}
        {%- capture dados -%}
          {%- render 'inventory-status-aviso',
            variante: variante,
            limite: limite,
            mostra_quantidade: mostra_quantidade,
            estilo: estilo,
            modo: 'dados'
          -%}
        {%- endcapture -%}
        {%- if dados != '' -%}
          {{- separador }}"{{ variante.id }}":{{ dados -}}
          {%- assign separador = ',' -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    <script type="application/json" data-estoque-variantes>{ {{- mapa -}} }</script>

    <script>
      (function () {
        var raiz = document.currentScript && document.currentScript.parentElement;
        var contexto = raiz && raiz.closest('[product-context]');
        if (!contexto) return;

        var avisos = JSON.parse(raiz.querySelector('[data-estoque-variantes]').textContent);
        var alvo = raiz.querySelector('[data-estoque-aviso]');

        contexto.addEventListener('variant:change', function (event) {
          var variante = event.detail && event.detail.variant;
          if (!variante) return;

          // [estado, título, subtítulo]; variante sem aviso não está no mapa.
          var aviso = avisos[variante.id];
          var modelo = aviso && raiz.querySelector('template[data-estoque-modelo="' + aviso[0] + '"]');

          if (!modelo) {
            alvo.replaceChildren();
            raiz.hidden = true;
            return;
          }

          var copia = modelo.content.cloneNode(true);
          var titulo = copia.querySelector('[data-titulo]');
          var subtitulo = copia.querySelector('[data-subtitulo]');
          if (titulo) titulo.textContent = aviso[1];
          if (subtitulo) subtitulo.textContent = aviso[2];

          alvo.replaceChildren(copia);
          raiz.hidden = false;
        });
      })();
    </script>
  {%- endunless -%}
</div>
