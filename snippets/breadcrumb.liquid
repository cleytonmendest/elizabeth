{%- comment -%}
  snippets/breadcrumb.liquid
{%- endcomment -%}
{%- comment -%}
  A caixa é DELE, e não do layout.

  O `layout/theme.liquid` envolvia este render num `<div class="page-width
  py-4">` que era emitido sempre — inclusive na home, onde o breadcrumb não
  renderiza nada. Sobravam 32px de padding sem conteúdo no topo de toda home,
  mais o `gap` entre as sections. Medido, não estimado.

  Ninguém notava porque 32px de branco acima de um banner branco não chamam
  atenção. Chamam quando o cabeçalho passa a ser transparente sobre o herói
  (#121): aí o herói precisa começar colado no topo, e esse espaço vira uma
  faixa visível entre o cabeçalho e a imagem.

  Caixa que só existe quando há conteúdo resolve os dois casos de uma vez.
{%- endcomment -%}
{%- if template.name != 'index' -%}
  <div class="page-width py-4 w-full">
  <nav aria-label="{{ 'general.breadcrumbs.aria_label' | t }}" class="breadcrumb-nav sm:text-sm text-xs w-full my-2">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
      <li>
        <a href="{{ routes.root_url }}" class="text-foreground-muted hover:underline hover:text-foreground">{{ 'general.breadcrumbs.home' | t }}</a>
      </li>

      {%- case template.name -%}
        {%- comment -%}
          `/collections`. O `when` existia desde antes do template — a página
          só passou a ser servida pelo tema na #27.
        {%- endcomment -%}
        {%- when 'list-collections' -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ 'general.breadcrumbs.all_collections' | t }}</span>
          </li>

        {%- when 'product' -%}
          {%- assign product_collection = product.collections.first -%}
          {%- if product_collection -%}
            <li class="text-foreground-muted hover:text-foreground">
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
              <a href="{{ product_collection.url }}" class="breadcrumb-link hover:underline">
                {{- product_collection.title -}}
              </a>
            </li>
          {%- else -%}
            <li class="text-foreground-muted hover:text-foreground">
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
              <a href="{{ routes.all_products_collection_url }}" class="breadcrumb-link hover:underline">{{ 'general.breadcrumbs.products' | t }}</a>
            </li>
          {%- endif -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ product.title }}</span>
          </li>

        {%- when 'collection' -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ collection.title }}</span>
          </li>

        {%- when 'article' -%}
          {%- if blog -%}
            <li class="text-foreground-muted hover:text-foreground">
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
              <a href="{{ blog.url }}" class="breadcrumb-link hover:underline">{{ blog.title }}</a>
            </li>
          {%- endif -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ article.title }}</span>
          </li>

        {%- when 'blog' -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ blog.title }}</span>
          </li>

        {%- when 'page' -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ page.title }}</span>
          </li>

        {%- when 'search' -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <a href="{{ routes.search_url }}" class="breadcrumb-link hover:underline">{{ 'general.breadcrumbs.search' | t }}</a>
          </li>
          {%- if search.performed -%}
            <li class="text-foreground-muted hover:text-foreground">
              <span class="breadcrumb-separator" aria-hidden="true">/</span>
              <span class="breadcrumb-current" aria-current="page">{{ search.terms | escape }}</span>
            </li>
          {%- endif -%}

        {%- else -%}
          <li class="text-foreground-muted hover:text-foreground">
            <span class="breadcrumb-separator" aria-hidden="true">/</span>
            <span class="breadcrumb-current" aria-current="page">{{ page_title }}</span>
          </li>
      {%- endcase -%}
    </ol>
  </nav>
  </div>
{%- endif -%}
