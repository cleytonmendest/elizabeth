{%- comment -%}
  Organization Schema (JSON-LD) para SEO
  Define a identidade da marca/loja nos resultados de busca

  Usar no layout/theme.liquid (apenas uma vez por página)
{%- endcomment -%}

{%- liquid
  assign logo_url = ''
  if settings.logo
    assign logo_url = settings.logo | image_url: width: 600
  elsif shop.brand.logo
    assign logo_url = shop.brand.logo | image_url: width: 600
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ request.origin | json }},
  {%- if logo_url != blank -%}
  "logo": {{ logo_url | json }},
  {%- endif -%}
  {%- if shop.description -%}
  "description": {{ shop.description | json }},
  {%- endif -%}
  {%- comment -%}
    O telefone só entra se a loja tiver um. O default anterior era um número
    brasileiro inventado (+55-11-99999-9999), publicado ao Google como contato
    da loja — pior que campo ausente, porque campo ausente não mente.

    `areaServed` e `availableLanguage` vêm da loja e do idioma pedido, não de
    "BR"/"Portuguese" escritos aqui: numa loja em inglês eles afirmavam ao
    Google exatamente o contrário do que a página mostra.
  {%- endcomment -%}
  {%- if shop.phone != blank -%}
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": {{ shop.phone | json }},
    "contactType": "Customer Service",
    "areaServed": {{ shop.address.country_code | json }},
    "availableLanguage": [{{ request.locale.iso_code | json }}]
  },
  {%- endif -%}
  "sameAs": [
    {%- comment -%} Adicionar redes sociais aqui {%- endcomment -%}
    {%- if settings.social_instagram_link -%}
      {{ settings.social_instagram_link | json }}{%- if settings.social_facebook_link or settings.social_pinterest_link -%},{%- endif -%}
    {%- endif -%}
    {%- if settings.social_facebook_link -%}
      {{ settings.social_facebook_link | json }}{%- if settings.social_pinterest_link -%},{%- endif -%}
    {%- endif -%}
    {%- if settings.social_pinterest_link -%}
      {{ settings.social_pinterest_link | json }}
    {%- endif -%}
  ],
  "address": {
    "@type": "PostalAddress",
    "addressCountry": {{ shop.address.country_code | json }}
  }
}
</script>
