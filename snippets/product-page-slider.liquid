{% if product_ref != blank %}
  {% assign product = product_ref %}
{% endif %}

{%- comment -%}
  As fotos são pedidas na largura em que aparecem (#163): antes saíam no
  tamanho original, e TODAS de imediato, inclusive no desktop, onde nos
  layouts empilhado e de duas colunas este slider fica escondido. Agora só a
  primeira carrega na hora; as outras esperam chegar perto da tela.

  `prioridade`: a PDP passa `true`, porque ali a primeira foto é o LCP no
  celular. O "Produto em destaque" não passa: numa section no meio da página,
  pedir prioridade alta roubaria banda do que está no topo.
{%- endcomment -%}
{%- liquid
  assign por_vez = qtd | default: 1
  assign largura_desktop = 50 | divided_by: por_vez
  assign tamanhos = '(min-width: 1024px) ' | append: largura_desktop | append: 'vw, 100vw'
-%}

{%- comment -%}
  Navegação por breakpoint:
  - Mobile: dots minimalistas + contador "X / N" (setas ocultas)
  - Desktop: setas ‹ › (dots/contador ocultos) — comportamento original preservado
{%- endcomment -%}
<style>
  my-slider.pdp-gallery { display: block; position: relative; }
  my-slider.pdp-gallery .swiper-pagination {
    position: absolute; bottom: 12px; left: 0; right: 0;
    display: flex; justify-content: center; align-items: center; gap: 6px; z-index: 10;
  }
  my-slider.pdp-gallery .swiper-pagination-bullet {
    width: 6px; height: 6px; margin: 0 !important; border-radius: 9999px;
    background: rgb(var(--color-foreground)); opacity: .3; transition: all .25s ease;
  }
  my-slider.pdp-gallery .swiper-pagination-bullet-active { opacity: 1; width: 18px; border-radius: 3px; }
  @media (min-width: 1024px) { my-slider.pdp-gallery .swiper-pagination { display: none; } }
</style>

<my-slider
  class="pdp-gallery block w-full"
  data-section-id="{{ section.id }}"
  data-loop="true"
  data-items="{{ product.images.size }}"
  data-qty-desk="{{ qtd }}"
  data-qty-tab="{{ qtd }}"
  data-qty-mob="1"
  style="--por-vez-mob: 1; --por-vez-tab: {{ qtd }}; --por-vez-desk: {{ qtd }}"
  data-autoplay="false"
  data-ap-time=""
  data-pause-hover=""
  data-dot="true"
>
  {% comment %} OBRIGATORIO TER A DIV "my-slider__container" PARA O CORRETO FUNCIONAMENTO {% endcomment %}
  <div class="my-slider__container overflow-hidden">
    {%- for image in product.images -%}
      <div class="carousel-item flex justify-center">
        {%- liquid
          assign carregamento = 'lazy'
          assign prioridade_da_foto = 'auto'
          if forloop.first
            assign carregamento = 'eager'
            if prioridade
              assign prioridade_da_foto = 'high'
            endif
          endif
        -%}
        {{
          image
          | image_url: width: 1200
          | image_tag:
            widths: '400, 600, 800, 1000, 1200',
            sizes: tamanhos,
            class: 'w-full',
            alt: product.title,
            loading: carregamento,
            fetchpriority: prioridade_da_foto,
            decoding: 'async'
        }}
      </div>
    {% endfor %}
  </div>

  {%- comment -%} Contador de posição — somente mobile {%- endcomment -%}
  {%- if product.images.size > 1 -%}
    <div class="lg:hidden absolute top-3 right-3 z-sticky bg-background/85 text-foreground text-xs tracking-wide rounded-theme px-2.5 py-1">
      <span class="index-active">1</span> / {{ product.images.size }}
    </div>
  {%- endif -%}
</my-slider>

{%- comment -%} Setas — somente desktop {%- endcomment -%}
<div class="hidden lg:flex absolute w-full justify-between top-[50%] z-sticky">
  {%- comment -%}
    O aria-label não é enfeite: o conteúdo do botão é só um SVG, então sem ele
    o leitor de tela anuncia "botão" e nada mais. O axe classifica como
    button-name, gravidade crítica — foi o primeiro achado do gate de
    acessibilidade quando ele rodou contra a loja pela primeira vez.
  {%- endcomment -%}
  <button
    type="button"
    aria-label="{{ 'general.accessibility.previous' | t }}"
    onclick="sliderPrev('{{ section.id }}')"
    class="text-foreground"
  >
    {% render 'icon-short-arrow-left', size: 40 %}
  </button>
  <button
    type="button"
    aria-label="{{ 'general.accessibility.next' | t }}"
    onclick="sliderNext('{{ section.id }}')"
    class="text-foreground"
  >
    {% render 'icon-short-arrow-right', size: 40 %}
  </button>
</div>
