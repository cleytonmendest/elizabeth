[
  {
    "name": "theme_info",
    "theme_name": "Elizabeth",
    "theme_version": "1.0.0",
    "theme_author": "Cleyton Mendes",
    "theme_documentation_url": "https://github.com/Shopify/themekit",
    "theme_support_url": "https://github.com/Shopify/themekit/issues"
  },
  {
    "name": "Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo Principal"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "Largura máxima da Logo (Header)"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Imagem que exibirá na Tab do navegador"
      },
      {
        "type": "textarea",
        "id": "logo_svg",
        "label": "Logo SVG (Header)",
        "info": "Caso incluído, utilizará o svg inserido desconsiderando campo 'Logo principal'. Melhor para alterações de cores"
      }
    ]
  },
  {
    "name": "Parcelamento (somente visual)",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_installments",
        "label": "Exibe informações de parcelamentos nos produtos?",
        "info": "Caso desativado, não exibirá nenhuma informação de parcelamento. Nem nas prateleiras nem na Página de Produto",
        "default": true
      },
      {
        "type": "number",
        "label": "Quantidade máxima de parcelamento",
        "info": "Quantidade máxima de parcelas que a loja consegue, ex: 10. Isto quer dizer que pode parcelar até em 10x",
        "default": 10,
        "id": "max_installments"
      },
      {
        "type": "number",
        "label": "Valor mínimo de parcelas",
        "info": "Valor mínimo por parcela, ex: 100. Se colocar o valor 100 só vai exibir o parcelamento no produto se o valor do produto for no minimo 200, fazendo R$200,00 em 2x = R$100,00 por parcela",
        "id": "min_value_installment",
        "default": 50
      }
    ]
  },
  {
    "name": "Cores",
    "settings": [
      {
        "type": "paragraph",
        "content": "Configure esquemas de cores reutilizáveis. Cada seção pode escolher qual esquema usar."
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "Fundo",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "Gradiente de fundo",
            "info": "Sobrepõe a cor de fundo se definido"
          },
          {
            "type": "color",
            "id": "text",
            "label": "Texto",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button",
            "label": "Botão primário",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "Texto do botão primário",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "Texto do botão secundário",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "border",
            "label": "Bordas",
            "default": "#E5E7EB"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "Sombras",
            "default": "#121212"
          },
          {
            "type": "header",
            "content": "Badges e Destaques"
          },
          {
            "type": "color",
            "id": "badge_background",
            "label": "Fundo de badge",
            "default": "#DC2626"
          },
          {
            "type": "color",
            "id": "badge_text",
            "label": "Texto de badge",
            "default": "#FFFFFF"
          },
          {
            "type": "header",
            "content": "Feedback"
          },
          {
            "type": "color",
            "id": "success",
            "label": "Sucesso",
            "default": "#059669"
          },
          {
            "type": "color",
            "id": "error",
            "label": "Erro",
            "default": "#DC2626"
          },
          {
            "type": "color",
            "id": "warning",
            "label": "Alerta",
            "default": "#F59E0B"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "border"
        }
      },
      {
        "type": "header",
        "content": "Páginas de Cliente"
      },
      {
        "type": "color_scheme",
        "id": "customer_color_scheme",
        "label": "Esquema de cores das páginas de conta",
        "default": "scheme-1",
        "info": "Aplica-se a login, cadastro, conta, pedidos e endereços"
      }
    ]
  },
  {
    "name": "t:settings_schema.design.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.design.intro"
      },
      {
        "type": "select",
        "id": "radius_style",
        "default": "8px",
        "label": "t:settings_schema.design.radius_style.label",
        "info": "t:settings_schema.design.radius_style.info",
        "options": [
          {
            "value": "0px",
            "label": "t:settings_schema.design.radius_style.options.none"
          },
          {
            "value": "4px",
            "label": "t:settings_schema.design.radius_style.options.subtle"
          },
          {
            "value": "8px",
            "label": "t:settings_schema.design.radius_style.options.soft"
          },
          {
            "value": "16px",
            "label": "t:settings_schema.design.radius_style.options.round"
          }
        ]
      },
      {
        "type": "select",
        "id": "font_scale",
        "default": "1",
        "label": "t:settings_schema.design.font_scale.label",
        "info": "t:settings_schema.design.font_scale.info",
        "options": [
          {
            "value": "0.9",
            "label": "t:settings_schema.design.font_scale.options.compact"
          },
          {
            "value": "1",
            "label": "t:settings_schema.design.font_scale.options.default"
          },
          {
            "value": "1.1",
            "label": "t:settings_schema.design.font_scale.options.large"
          },
          {
            "value": "1.2",
            "label": "t:settings_schema.design.font_scale.options.xlarge"
          }
        ]
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1400,
        "max": 2560,
        "step": 20,
        "default": 1920,
        "unit": "px",
        "label": "Largura máxima da Loja"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "Espaçamento entre Seções",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "show_back_to_top",
        "label": "Botão \"Voltar ao topo\"",
        "info": "Exibe um botão flutuante que retorna ao topo da página ao rolar.",
        "default": true
      }
    ]
  },
  {
    "name": "Tipografia",
    "settings": [
      {
        "type": "header",
        "content": "Títulos"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "Fonte",
        "info": "As fontes vêm da biblioteca da Shopify, servidas pelo CDN da loja. A escolha afeta a velocidade da página: uma família com muitos pesos custa mais para carregar."
      },
      {
        "type": "header",
        "content": "Corpo"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "Fonte",
        "info": "As fontes vêm da biblioteca da Shopify, servidas pelo CDN da loja. A escolha afeta a velocidade da página: uma família com muitos pesos custa mais para carregar."
      }
    ]
  },
  {
    "name": "Redes Sociais",
    "settings": [
      {
        "type": "header",
        "content": "Contas de redes sociais"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "Facebook",
        "placeholder": "https://facebook.com/shopify"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "Instagram",
        "placeholder": "https://instagram.com/shopify"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "Youtube",
        "placeholder": "https://www.youtube.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "Tiktok",
        "placeholder": "https://tiktok.com/@shopify"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "X / Twitter",
        "placeholder": "https://x.com/shopify"
      },
      {
        "type": "text",
        "id": "social_snapchat_link",
        "label": "Snapchat",
        "placeholder": "https://www.snapchat.com/add/shopify"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "Pinterest",
        "placeholder": "https://pinterest.com/shopify"
      },
      {
        "type": "text",
        "id": "social_tumblr_link",
        "label": "Tumblr",
        "placeholder": "https://shopify.tumblr.com"
      },
      {
        "type": "text",
        "id": "social_vimeo_link",
        "label": "Vimeo",
        "placeholder": "https://vimeo.com/shopify"
      }
    ]
  },
  {
    "name": "Carrinho",
    "settings": [
      {
        "type": "header",
        "content": "Frete grátis"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_enabled",
        "label": "Mostrar barra de progresso de frete grátis",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "Valor mínimo para frete grátis (R$)",
        "default": 299,
        "info": "Usado na barra de progresso do carrinho e do mini-carrinho. Defina 0 para desativar."
      },
      {
        "type": "text",
        "id": "cart_free_shipping_message",
        "label": "Mensagem de progresso",
        "default": "Faltam {valor} para o frete grátis",
        "info": "Use {valor} onde o valor restante deve aparecer."
      },
      {
        "type": "text",
        "id": "cart_free_shipping_success",
        "label": "Mensagem ao atingir o frete grátis",
        "default": "Você ganhou frete grátis!"
      },
      {
        "type": "header",
        "content": "Observações do pedido"
      },
      {
        "type": "checkbox",
        "id": "cart_notes",
        "label": "Permitir observações do cliente",
        "info": "Exibe um campo de observações no carrinho e no mini-carrinho.",
        "default": true
      }
    ]
  },
  {
    "name": "Privacidade e Cookies (LGPD)",
    "settings": [
      {
        "type": "paragraph",
        "content": "Banner de consentimento de cookies. Integra-se automaticamente à API de Privacidade do Shopify quando disponível. Desative se você usa o banner nativo do Shopify ou um app de consentimento."
      },
      {
        "type": "checkbox",
        "id": "enable_cookie_banner",
        "label": "Exibir banner de cookies",
        "default": true
      },
      {
        "type": "color_scheme",
        "id": "cookie_color_scheme",
        "label": "Esquema de cores do banner",
        "default": "scheme-2"
      },
      {
        "type": "richtext",
        "id": "cookie_message",
        "label": "Mensagem",
        "default": "<p>Usamos cookies para melhorar sua experiência, personalizar conteúdo e analisar o tráfego. Ao continuar navegando, você concorda com o uso de cookies.</p>"
      },
      {
        "type": "text",
        "id": "cookie_accept_label",
        "label": "Texto do botão aceitar",
        "default": "Aceitar"
      },
      {
        "type": "checkbox",
        "id": "cookie_show_decline",
        "label": "Mostrar botão recusar",
        "default": true
      },
      {
        "type": "text",
        "id": "cookie_decline_label",
        "label": "Texto do botão recusar",
        "default": "Recusar"
      },
      {
        "type": "url",
        "id": "cookie_privacy_link",
        "label": "Link da política de privacidade"
      },
      {
        "type": "text",
        "id": "cookie_privacy_label",
        "label": "Texto do link da política",
        "default": "Política de privacidade"
      }
    ]
  }
]
