[
  {
    "name": "theme_info",
    "theme_name": "Elizabeth",
    "theme_version": "1.0.0",
    "theme_author": "Cleyton Mendes",
    "theme_documentation_url": "https://github.com/Shopify/themekit",
    "theme_support_url": "https://github.com/Shopify/themekit/issues"
  },
  {
    "name": "t:settings_schema.logo.name",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.logo.logo.label"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "t:settings_schema.logo.logo_width.label"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.logo.favicon.label",
        "info": "t:settings_schema.logo.favicon.info"
      },
      {
        "type": "textarea",
        "id": "logo_svg",
        "label": "t:settings_schema.logo.logo_svg.label",
        "info": "t:settings_schema.logo.logo_svg.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.installments.name",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_installments",
        "label": "t:settings_schema.installments.show_installments.label",
        "info": "t:settings_schema.installments.show_installments.info",
        "default": true
      },
      {
        "type": "number",
        "label": "t:settings_schema.installments.max_installments.label",
        "info": "t:settings_schema.installments.max_installments.info",
        "default": 10,
        "id": "max_installments"
      },
      {
        "type": "number",
        "label": "t:settings_schema.installments.min_value_installment.label",
        "info": "t:settings_schema.installments.min_value_installment.info",
        "id": "min_value_installment",
        "default": 50
      }
    ]
  },
  {
    "name": "t:settings_schema.colors.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.colors.intro.content"
      },
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          {
            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.color_schemes.background.label",
            "default": "#FFFFFF"
          },
          {
            "type": "color_background",
            "id": "background_gradient",
            "label": "t:settings_schema.colors.color_schemes.background_gradient.label",
            "info": "t:settings_schema.colors.color_schemes.background_gradient.info"
          },
          {
            "type": "color",
            "id": "text",
            "label": "t:settings_schema.colors.color_schemes.text.label",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button",
            "label": "t:settings_schema.colors.color_schemes.button.label",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "button_label",
            "label": "t:settings_schema.colors.color_schemes.button_label.label",
            "default": "#FFFFFF"
          },
          {
            "type": "color",
            "id": "secondary_button_label",
            "label": "t:settings_schema.colors.color_schemes.secondary_button_label.label",
            "default": "#121212"
          },
          {
            "type": "color",
            "id": "border",
            "label": "t:settings_schema.colors.color_schemes.border.label",
            "default": "#E5E7EB"
          },
          {
            "type": "color",
            "id": "shadow",
            "label": "t:settings_schema.colors.color_schemes.shadow.label",
            "default": "#121212"
          },
          {
            "type": "header",
            "content": "Badges e Destaques"
          },
          {
            "type": "color",
            "id": "badge_background",
            "label": "t:settings_schema.colors.color_schemes.badge_background.label",
            "default": "#DC2626"
          },
          {
            "type": "color",
            "id": "badge_text",
            "label": "t:settings_schema.colors.color_schemes.badge_text.label",
            "default": "#FFFFFF"
          },
          {
            "type": "header",
            "content": "Feedback"
          },
          {
            "type": "color",
            "id": "success",
            "label": "t:settings_schema.colors.color_schemes.success.label",
            "default": "#059669"
          },
          {
            "type": "color",
            "id": "error",
            "label": "t:settings_schema.colors.color_schemes.error.label",
            "default": "#DC2626"
          },
          {
            "type": "color",
            "id": "warning",
            "label": "t:settings_schema.colors.color_schemes.warning.label",
            "default": "#F59E0B"
          }
        ],
        "role": {
          "text": "text",
          "background": {
            "solid": "background",
            "gradient": "background_gradient"
          },
          "links": "secondary_button_label",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "secondary_button_label",
          "secondary_button_border": "border"
        }
      },
      {
        "type": "header",
        "content": "t:settings_schema.colors.customer_pages.content"
      },
      {
        "type": "color_scheme",
        "id": "customer_color_scheme",
        "label": "t:settings_schema.colors.customer_color_scheme.label",
        "default": "scheme-1",
        "info": "t:settings_schema.colors.customer_color_scheme.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.design.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.design.intro"
      },
      {
        "type": "select",
        "id": "radius_style",
        "default": "8px",
        "label": "t:settings_schema.design.radius_style.label",
        "info": "t:settings_schema.design.radius_style.info",
        "options": [
          {
            "value": "0px",
            "label": "t:settings_schema.design.radius_style.options.none"
          },
          {
            "value": "4px",
            "label": "t:settings_schema.design.radius_style.options.subtle"
          },
          {
            "value": "8px",
            "label": "t:settings_schema.design.radius_style.options.soft"
          },
          {
            "value": "16px",
            "label": "t:settings_schema.design.radius_style.options.round"
          }
        ]
      },
      {
        "type": "select",
        "id": "font_scale",
        "default": "1",
        "label": "t:settings_schema.design.font_scale.label",
        "info": "t:settings_schema.design.font_scale.info",
        "options": [
          {
            "value": "0.9",
            "label": "t:settings_schema.design.font_scale.options.compact"
          },
          {
            "value": "1",
            "label": "t:settings_schema.design.font_scale.options.default"
          },
          {
            "value": "1.1",
            "label": "t:settings_schema.design.font_scale.options.large"
          },
          {
            "value": "1.2",
            "label": "t:settings_schema.design.font_scale.options.xlarge"
          }
        ]
      }
    ]
  },
  {
    "name": "t:settings_schema.layout.name",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1400,
        "max": 2560,
        "step": 20,
        "default": 1920,
        "unit": "px",
        "label": "t:settings_schema.layout.page_width.label"
      },
      {
        "type": "range",
        "id": "spacing_sections",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:settings_schema.layout.spacing_sections.label",
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "show_back_to_top",
        "label": "t:settings_schema.layout.show_back_to_top.label",
        "info": "t:settings_schema.layout.show_back_to_top.info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.typography.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.typography.headings.content"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.type_header_font.label",
        "info": "t:settings_schema.typography.type_header_font.info"
      },
      {
        "type": "header",
        "content": "t:settings_schema.typography.body.content"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "assistant_n4",
        "label": "t:settings_schema.typography.type_body_font.label",
        "info": "t:settings_schema.typography.type_body_font.info"
      }
    ]
  },
  {
    "name": "t:settings_schema.social.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.social.accounts.content"
      },
      {
        "type": "text",
        "id": "social_facebook_link",
        "label": "t:settings_schema.social.social_facebook_link.label",
        "placeholder": "t:settings_schema.social.social_facebook_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_instagram_link",
        "label": "t:settings_schema.social.social_instagram_link.label",
        "placeholder": "t:settings_schema.social.social_instagram_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_youtube_link",
        "label": "t:settings_schema.social.social_youtube_link.label",
        "placeholder": "t:settings_schema.social.social_youtube_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_tiktok_link",
        "label": "t:settings_schema.social.social_tiktok_link.label",
        "placeholder": "t:settings_schema.social.social_tiktok_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_twitter_link",
        "label": "t:settings_schema.social.social_twitter_link.label",
        "placeholder": "t:settings_schema.social.social_twitter_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_snapchat_link",
        "label": "t:settings_schema.social.social_snapchat_link.label",
        "placeholder": "t:settings_schema.social.social_snapchat_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_pinterest_link",
        "label": "t:settings_schema.social.social_pinterest_link.label",
        "placeholder": "t:settings_schema.social.social_pinterest_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_tumblr_link",
        "label": "t:settings_schema.social.social_tumblr_link.label",
        "placeholder": "t:settings_schema.social.social_tumblr_link.placeholder"
      },
      {
        "type": "text",
        "id": "social_vimeo_link",
        "label": "t:settings_schema.social.social_vimeo_link.label",
        "placeholder": "t:settings_schema.social.social_vimeo_link.placeholder"
      }
    ]
  },
  {
    "name": "t:settings_schema.cart.name",
    "settings": [
      {
        "type": "header",
        "content": "t:settings_schema.cart.free_shipping.content"
      },
      {
        "type": "checkbox",
        "id": "cart_free_shipping_enabled",
        "label": "t:settings_schema.cart.cart_free_shipping_enabled.label",
        "default": true
      },
      {
        "type": "number",
        "id": "cart_free_shipping_threshold",
        "label": "t:settings_schema.cart.cart_free_shipping_threshold.label",
        "default": 299,
        "info": "t:settings_schema.cart.cart_free_shipping_threshold.info"
      },
      {
        "type": "text",
        "id": "cart_free_shipping_message",
        "label": "t:settings_schema.cart.cart_free_shipping_message.label",
        "default": "Faltam {valor} para o frete grátis",
        "info": "t:settings_schema.cart.cart_free_shipping_message.info"
      },
      {
        "type": "text",
        "id": "cart_free_shipping_success",
        "label": "t:settings_schema.cart.cart_free_shipping_success.label",
        "default": "Você ganhou frete grátis!"
      },
      {
        "type": "header",
        "content": "t:settings_schema.cart.order_notes.content"
      },
      {
        "type": "checkbox",
        "id": "cart_notes",
        "label": "t:settings_schema.cart.cart_notes.label",
        "info": "t:settings_schema.cart.cart_notes.info",
        "default": true
      }
    ]
  },
  {
    "name": "t:settings_schema.privacy.name",
    "settings": [
      {
        "type": "paragraph",
        "content": "t:settings_schema.privacy.intro.content"
      },
      {
        "type": "checkbox",
        "id": "enable_cookie_banner",
        "label": "t:settings_schema.privacy.enable_cookie_banner.label",
        "default": true
      },
      {
        "type": "color_scheme",
        "id": "cookie_color_scheme",
        "label": "t:settings_schema.privacy.cookie_color_scheme.label",
        "default": "scheme-2"
      },
      {
        "type": "richtext",
        "id": "cookie_message",
        "label": "t:settings_schema.privacy.cookie_message.label",
        "default": "<p>Usamos cookies para melhorar sua experiência, personalizar conteúdo e analisar o tráfego. Ao continuar navegando, você concorda com o uso de cookies.</p>"
      },
      {
        "type": "text",
        "id": "cookie_accept_label",
        "label": "t:settings_schema.privacy.cookie_accept_label.label",
        "default": "Aceitar"
      },
      {
        "type": "checkbox",
        "id": "cookie_show_decline",
        "label": "t:settings_schema.privacy.cookie_show_decline.label",
        "default": true
      },
      {
        "type": "text",
        "id": "cookie_decline_label",
        "label": "t:settings_schema.privacy.cookie_decline_label.label",
        "default": "Recusar"
      },
      {
        "type": "url",
        "id": "cookie_privacy_link",
        "label": "t:settings_schema.privacy.cookie_privacy_link.label"
      },
      {
        "type": "text",
        "id": "cookie_privacy_label",
        "label": "t:settings_schema.privacy.cookie_privacy_label.label",
        "default": "Política de privacidade"
      }
    ]
  }
]
