{%- comment -%}
  O mini-carrinho. É uma SECTION, e não um snippet, por um motivo só.

  ── Por que section ────────────────────────────────────────────────────────

  Depois de adicionar um produto, o drawer precisa redesenhar os itens. Ele
  fazia isso baixando a PÁGINA DO CARRINHO INTEIRA — `<head>`, cabeçalho,
  rodapé, todo o CSS e JS referenciado — para extrair o `innerHTML` de uma
  `<div>`. A cada clique.

  A saída idiomática é a Section Rendering API, que devolve só o fragmento de
  uma section. Ela precisa de um `section_id`, e aí estava o problema: o
  carrinho é um template JSON, onde o id é a CHAVE que alguém escolheu
  (`"main"`), não o tipo. Cravar `?section_id=main` no JavaScript amarraria um
  asset a uma chave de template, que some em silêncio se alguém renomear.

  Como section estática renderizada pelo layout, o id é o NOME DESTE ARQUIVO.
  Não há chave para renomear, e o que o JS pede é o que o disco tem.

  ── O schema é vazio de propósito ──────────────────────────────────────────

  Não há setting aqui, e não deve haver: o drawer não tem nada que a lojista
  decida — o que ele mostra vem do carrinho, e as cores vêm do scheme do
  layout. Um schema com settings inventados só para "ser uma section de
  verdade" seria pior que nenhum.
{%- endcomment -%}
{{ 'cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'cart.js' | asset_url }}" defer></script>
<script src="{{ 'cart-extras.js' | asset_url }}" defer></script>

<div data-section-id="{{ section.id }}">
<cart-drawer
  class="cart-drawer fixed z-drawer left-0 top-0 w-screen h-full flex justify-end bg-foreground/50"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'cart.general.title' | t }}"
>
  <div class="cart-drawer">
    <div class="cart-inner pb-16 h-full w-full sm:w-[385px] bg-background z-sticky relative" tabindex="-1">
      <div class="cart-header flex h-16 px-4 items-center border-b border-border">
        <span class="flex-1 flex items-center justify-center text-sm uppercase tracking-label text-foreground/70">{{ 'cart.general.title' | t }}</span>
        <button
          class="w-5 hover:opacity-70 transition-opacity"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'general.accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
      </div>

      <div id="cart-empty" class="h-full {% if cart == empty %}flex{% else %}hidden{% endif %} items-center justify-center flex-col px-6 text-center">
        <h3 class="text-xl font-light tracking-title mb-1">{{ 'cart.general.empty' | t }}</h3>
        <p class="text-sm text-foreground-muted mb-6">{{ 'cart.general.empty_text' | t }}</p>
        <button
          type="button"
          onclick="this.closest('cart-drawer').close()"
          class="inline-flex items-center color-button text-xs uppercase tracking-label px-6 py-3.5 rounded-theme hover:opacity-90 transition-opacity"
        >
          {{ 'cart.general.continue_shopping' | t }}
        </button>
      </div>

      <div id="cart-container" class="{% if cart == empty %}hidden{% else %}flex{% endif %} flex-col h-full">
        <div class="flex flex-col flex-1 overflow-y-auto" id="cart-drawer-items">
          {% for item in cart.items %}
            {% render 'cart-drawer-item', item: item %}
          {% endfor %}
        </div>
        <div class="p-4 border-t border-border shadow-[0_-4px_12px_rgba(0,0,0,0.06)]">
          {% render 'cart-free-shipping' %}

          <div id="cart-summary-total" class="summary flex flex-col gap-2 mt-4 mb-4">
            <div class="flex justify-between text-sm">
              <div class="text-foreground/60">{{ 'cart.general.subtotal' | t }}</div>
              <div class="subtotal font-medium">
                {{ cart.items_subtotal_price | money }}
              </div>
            </div>
            {% if cart.total_discount > 0 %}
              <div class="flex justify-between text-sm">
                <div class="text-foreground/60">{{ 'cart.general.discounts' | t }}</div>
                <div class="discounts font-medium color-success">
                  -{{ cart.total_discount | money }}
                </div>
              </div>
            {% endif %}
            <div class="flex justify-between items-baseline pt-2 border-t border-border">
              <div class="text-sm font-medium">{{ 'cart.general.total' | t }}</div>
              <div class="total-price text-base font-light">
                {{ cart.total_price | money }}
              </div>
            </div>
          </div>
          {%- if settings.cart_notes -%}
            <details class="cart-note mb-4"{% if cart.note != blank %} open{% endif %}>
              <summary class="flex cursor-pointer list-none items-center justify-between py-1 text-xs uppercase tracking-label text-foreground/60 hover:text-foreground transition-colors">
                <span>{{ 'cart.general.note' | t }}</span>
                <span class="cart-note-chevron shrink-0 opacity-60 transition-transform">
                  {% render 'icon-angle-down', size: 16 %}
                </span>
              </summary>
              <textarea
                id="CartDrawerNote"
                data-cart-note
                rows="2"
                placeholder="{{ 'cart.general.note_placeholder' | t | escape }}"
                class="mt-2 w-full border border-border rounded-theme px-3 py-2 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/40 resize-none"
              >{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
          <button
            class="color-button-secondary w-full h-11 flex items-center justify-center text-xs uppercase tracking-label transition-colors rounded-theme"
            type="button"
            onclick="this.closest('cart-drawer').close()"
          >
            {{ 'cart.general.continue_shopping' | t }}
          </button>
          <a
            href="/checkout"
            data-cart-checkout
            class="color-button flex cursor-pointer h-11 w-full items-center justify-center mt-3 text-xs uppercase tracking-label transition-opacity rounded-theme hover:opacity-90"
            >{{ 'cart.general.checkout' | t }}</a
          >
        </div>
      </div>
    </div>
    <div id="minicart-overlay" class="fixed top-0 left-0 right-0 bottom-0"></div>
  </div>
</cart-drawer>
</div>

{% schema %}
{
  "name": "t:sections.cart_drawer.name",
  "settings": []
}
{% endschema %}
