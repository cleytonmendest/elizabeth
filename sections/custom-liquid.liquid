{%- comment -%}
  sections/custom-liquid.liquid — Liquid personalizado, em qualquer template.

  Para o que o tema não prevê e não merece uma section: o trecho de um app
  antigo, um pixel de conversão só numa página, um metafield que o tema não
  conhece. Requisito da Theme Store junto com os app blocks (#145).

  ── Por que o setting mora AQUI ──────────────────────────────────────────

  O setting `liquid` é texto livre da lojista e sai cru — é o que ele existe
  para fazer. A regra `remotes` reprova exatamente isso quando o setting é
  GLOBAL (config/settings_schema.json): lá ele alcançaria toda página, e
  inclusive o `<head>`. Aqui o alcance é o desta section, na página em que a
  lojista a colocou. Não mova este setting para o schema global.

  Vazio: nada é renderizado — nem o fundo, nem o padding. Uma section
  adicionada e ainda não preenchida não abre um vão colorido na página.
{%- endcomment -%}

{%- if section.settings.custom_liquid != blank -%}
  <div class="color-{{ section.settings.color_scheme }} color-background color-text">
    <div
      class="page-width"
      style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
    >
      {{ section.settings.custom_liquid }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.custom_liquid.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:sections.custom_liquid.settings.custom_liquid.label",
      "info": "t:sections.custom_liquid.settings.custom_liquid.info"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.custom_liquid.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.custom_liquid.settings.spacing_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_top.label",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.custom_liquid.settings.padding_bottom.label",
      "default": 40
    }
  ],
  "presets": [{ "name": "t:sections.custom_liquid.presets.name" }]
}
{% endschema %}
