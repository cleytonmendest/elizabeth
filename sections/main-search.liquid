{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}
{%- assign articles_per_page = 6 -%}

<div class="color-{{ section.settings.color_scheme }} color-background color-text">
  {%- render 'breadcrumb' -%}
  <div class="page-width py-8">
    <div class="text-center mb-10 md:mb-12">
      <h1 class="text-3xl md:text-4xl font-light tracking-title mb-5">
        {%- if search.performed -%}
          {{ 'general.search.results_for' | t: terms: search.terms }}
        {%- else -%}
          {{ 'general.search.title' | t }}
        {%- endif -%}
      </h1>

      {%- comment -%} Formulário de busca {%- endcomment -%}
      <form action="{{ routes.search_url }}" method="get" role="search" class="max-w-2xl mx-auto mb-6">
        <div class="relative">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
            class="w-full px-4 py-3 pr-12 border border-border rounded-theme focus:outline-none focus:ring-2 focus:ring-foreground/40 text-base"
            required
          >
          <button
            type="submit"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-foreground/40 hover:text-foreground transition-colors"
            aria-label="{{ 'general.search.submit' | t }}"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </button>
        </div>
      </form>

      {%- if search.performed -%}
        <p class="text-sm text-foreground-muted">
          {{ 'general.search.results_count' | t: count: search.results_count }}
        </p>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- paginate search.results by products_per_page -%}
        {%- comment -%}
          A aba de tipo ativa é a da URL (`type=`), que a Shopify devolve em
          `search.types`. Sem `type`, a busca usa os tipos padrão da loja.
        {%- endcomment -%}
        {%- liquid
          assign active_type = 'all'
          if search.types.size == 1 and shop.search_types.size > 1
            assign active_type = search.types.first
          endif
          assign sort_by = search.sort_by | default: search.default_sort_by
        -%}
        {%- capture active_filter_count -%}{%- render 'facets', part: 'count', filters: search.filters -%}{%- endcapture -%}
        {%- assign active_filter_count = active_filter_count | plus: 0 -%}

        {%- comment -%}
          Filtro facetado só fala de PRODUTO. A aba de artigos, ou uma busca que
          só achou artigo e página, não ganha painel — ver 'relevant' no snippet.
        {%- endcomment -%}
        {%- assign show_filters = false -%}
        {%- if section.settings.enable_filtering and search.types contains 'product' -%}
          {%- capture filters_relevant -%}{%- render 'facets', part: 'relevant', filters: search.filters -%}{%- endcapture -%}
          {%- if filters_relevant == 'true' -%}
            {%- assign show_filters = true -%}
          {%- endif -%}
        {%- endif -%}

        {%- capture clear_url -%}{{ routes.search_url }}?q={{ search.terms | url_encode }}{% if active_type != 'all' %}&type={{ active_type }}{% endif %}&sort_by={{ sort_by }}{%- endcapture -%}

        {%- comment -%}
          Abas por tipo: LINKS com `type=`, e não botões. Até a #141 eram botões
          que escondiam em JS o que já tinha vindo — só na página atual, com
          contagem da página atual, e a segunda página voltava misturada. O
          `type` da própria busca filtra no servidor e atravessa a paginação, e
          link funciona sem JS.
        {%- endcomment -%}
        {%- liquid
          assign show_type_tabs = false
          if section.settings.enable_type_filter and shop.search_types.size > 1
            if search.results_count > 0 or active_type != 'all'
              assign show_type_tabs = true
            endif
          endif
        -%}
        {%- if show_type_tabs -%}
          <nav aria-label="{{ 'collection.filters.filter_by' | t }}" class="mb-10">
            <ul class="flex flex-wrap gap-2 justify-center">
              {%- assign type_tabs = 'all,product,article,page' | split: ',' -%}
              {%- for type_tab in type_tabs -%}
                {%- if type_tab == 'all' or shop.search_types contains type_tab -%}
                  {%- liquid
                    case type_tab
                      when 'product'
                        assign type_label = 'general.search.products' | t
                      when 'article'
                        assign type_label = 'general.search.articles' | t
                      when 'page'
                        assign type_label = 'general.search.pages' | t
                      else
                        assign type_label = 'general.search.all' | t
                    endcase
                  -%}
                  <li>
                    <a
                      href="{{ routes.search_url }}?q={{ search.terms | url_encode }}{% if type_tab != 'all' %}&type={{ type_tab }}{% endif %}"
                      class="inline-block px-5 py-2 border rounded-full text-xs uppercase tracking-label transition-colors {% if type_tab == active_type %}bg-foreground text-background border-foreground{% else %}border-border text-foreground/70 hover:border-foreground/30{% endif %}"
                      {% if type_tab == active_type %}aria-current="page"{% endif %}
                    >
                      {{- type_label -}}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if search.results.size > 0 or active_filter_count > 0 -%}
          {%- comment -%} Separar resultados por tipo {%- endcomment -%}
          {%- assign products = search.results | where: 'object_type', 'product' -%}
          {%- assign articles = search.results | where: 'object_type', 'article' -%}
          {%- assign pages = search.results | where: 'object_type', 'page' -%}

          {%- comment -%}
            O mesmo form da coleção: GET, sidebar no desktop, gaveta no celular.
            `q` e `type` vão escondidos para o filtro refinar ESTA busca.
          {%- endcomment -%}
          <facet-filters class="block" data-reload-message="{{ 'collection.general.sort_reloaded' | t | escape }}">
          <form data-filter-form action="{{ routes.search_url }}" method="get" class="flex flex-col lg:flex-row gap-8">
          <input type="hidden" name="q" value="{{ search.terms | escape }}">
          {%- if active_type != 'all' -%}
            <input type="hidden" name="type" value="{{ active_type }}">
          {%- endif -%}
          {%- if show_filters -%}
            {%- render 'facets',
              part: 'panel',
              filters: search.filters,
              active_filter_count: active_filter_count,
              sort_by: sort_by,
              clear_url: clear_url
            -%}
          {%- endif -%}

          <div class="flex-1 min-w-0">
          {%- comment -%} As opções de ordem da busca (preço) só fazem sentido com produto {%- endcomment -%}
          {%- liquid
            assign show_sorting = false
            if section.settings.enable_sorting and search.results.size > 0 and search.types contains 'product'
              assign show_sorting = true
            endif
          -%}
          {%- if show_filters or show_sorting -%}
            <div class="flex items-center justify-between gap-3 mb-6">
              <div>
                {%- if show_filters -%}
                  {%- render 'facets', part: 'trigger', active_filter_count: active_filter_count -%}
                {%- endif -%}
              </div>
              {%- if show_sorting -%}
                <div class="flex items-center gap-2">
                  <label for="SortBy" class="text-sm font-medium hidden sm:inline">{{ 'collection.sorting.title' | t }}</label>
                  <select
                    id="SortBy"
                    name="sort_by"
                    class="border border-border rounded-theme px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/40"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
                    {%- endfor -%}
                  </select>
                  <noscript>
                    <button type="submit" class="border border-border rounded-theme px-3 py-2 text-sm">{{ 'collection.filters.apply' | t }}</button>
                  </noscript>
                </div>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if search.results.size == 0 -%}
            {%- comment -%} Filtro sem resultado: a busca achou algo, o filtro é que zerou {%- endcomment -%}
            <div class="text-center py-20">
              <h2 class="text-2xl font-light tracking-title mb-2">{{ 'collection.general.no_results' | t }}</h2>
              <p class="text-sm text-foreground-muted mb-8">{{ 'collection.general.no_results_text' | t }}</p>
              <a href="{{ clear_url }}" class="inline-flex items-center color-button text-xs uppercase tracking-label px-6 py-3.5 hover:opacity-90 transition-opacity rounded-theme">
                {{ 'collection.filters.clear' | t }}
              </a>
            </div>
          {%- endif -%}

          {%- comment -%} PRODUTOS {%- endcomment -%}
          {%- if products.size > 0 -%}
            <div class="search-section" data-section="products">
              <h2 class="text-xl md:text-2xl font-light tracking-title mb-6">{{ 'general.search.products' | t }}</h2>
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-{{ section.settings.products_per_row }} gap-4 md:gap-6 mb-12">
                {%- for product in products -%}
                  {%- render 'card-product-slider',
                    card_product: product,
                    show_second_image: false,
                    show_badges: true,
                    lazy_load: true,
                    remove_padding: true
                  -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} ARTIGOS {%- endcomment -%}
          {%- if articles.size > 0 -%}
            <div class="search-section" data-section="articles">
              <h2 class="text-xl md:text-2xl font-light tracking-title mb-6">{{ 'general.search.blog_articles' | t }}</h2>
              <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                {%- for article in articles limit: articles_per_page -%}
                  <article class="group border border-border rounded-theme overflow-hidden transition-colors hover:border-foreground/30">
                    <a href="{{ article.url }}" class="block">
                      {%- if article.image -%}
                        <div class="aspect-video overflow-hidden bg-foreground/5">
                          {%- comment -%} `image_tag` aplica o ponto focal no corte do `object-cover` (#142). {%- endcomment -%}
                          {%- assign article_image_alt = article.image.alt | default: '' -%}
                          {{
                            article.image
                            | image_url: width: 600
                            | image_tag:
                              alt: article_image_alt,
                              class: 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-105',
                              loading: 'lazy',
                              decoding: 'async'
                          }}
                        </div>
                      {%- endif -%}
                      <div class="p-4">
                        <p class="text-xs uppercase tracking-[0.12em] text-foreground-muted mb-2">
                          {{ article.published_at | date: "%d/%m/%Y" }}
                        </p>
                        <h3 class="text-base font-normal mb-2 line-clamp-2">
                          {{ article.title }}
                        </h3>
                        {%- if article.excerpt != blank -%}
                          <p class="text-sm text-foreground/60 line-clamp-3">
                            {{ article.excerpt | strip_html }}
                          </p>
                        {%- endif -%}
                      </div>
                    </a>
                  </article>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- comment -%} PÁGINAS {%- endcomment -%}
          {%- if pages.size > 0 -%}
            <div class="search-section" data-section="pages">
              <h2 class="text-xl md:text-2xl font-light tracking-title mb-6">{{ 'general.search.pages' | t }}</h2>
              <div class="space-y-4 mb-12">
                {%- for page in pages -%}
                  <div class="border border-border rounded-theme p-4 transition-colors hover:border-foreground/30">
                    <a href="{{ page.url }}" class="block">
                      <h3 class="text-base font-normal mb-2">{{ page.title }}</h3>
                      {%- if page.content != blank -%}
                        <p class="text-sm text-foreground/60 line-clamp-2">
                          {{ page.content | strip_html | truncatewords: 30 }}
                        </p>
                      {%- endif -%}
                    </a>
                  </div>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}

          {%- if paginate.pages > 1 -%}
            <div class="mt-12">
              {%- render 'pagination', paginate: paginate -%}
            </div>
          {%- endif -%}
          </div>
          </form>
          </facet-filters>
        {%- else -%}
          {%- comment -%} Nenhum resultado {%- endcomment -%}
          <div class="text-center py-20">
            <svg class="w-16 h-16 mx-auto text-foreground/25 mb-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <h2 class="text-2xl font-light tracking-title mb-2">{{ 'general.search.no_results_title' | t }}</h2>
            <p class="text-sm text-foreground-muted mb-6">
              {{ 'general.search.no_results_text_html' | t: terms: search.terms }}
            </p>

            {%- if section.settings.show_suggestions -%}
              <div class="max-w-md mx-auto">
                <h3 class="text-xs uppercase tracking-label text-foreground/60 mb-4">{{ 'general.search.suggestions_title' | t }}</h3>
                <ul class="text-left text-sm text-foreground-muted space-y-2">
                  <li>• {{ 'general.search.suggestion_1' | t }}</li>
                  <li>• {{ 'general.search.suggestion_2' | t }}</li>
                  <li>• {{ 'general.search.suggestion_3' | t }}</li>
                  <li>• {{ 'general.search.suggestion_4' | t }}</li>
                </ul>
              </div>
            {%- endif -%}

            <a href="{{ routes.all_products_collection_url }}" class="inline-flex items-center mt-8 bg-foreground text-background text-xs uppercase tracking-label px-6 py-3.5 hover:opacity-90 transition-opacity">
              {{ 'general.search.view_all_products' | t }}
            </a>
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      {%- comment -%} Página inicial de busca - mostrar sugestões ou categorias populares {%- endcomment -%}
      {%- if section.settings.show_popular_searches -%}
        <div class="max-w-2xl mx-auto text-center">
          <h2 class="text-xs uppercase tracking-label text-foreground/60 mb-5">{{ 'general.search.popular_searches' | t }}</h2>
          <div class="flex flex-wrap gap-2 justify-center">
            {%- assign popular_terms = section.settings.popular_terms | split: ',' -%}
            {%- for term in popular_terms -%}
              <a
                href="{{ routes.search_url }}?q={{ term | strip | url_encode }}"
                class="px-5 py-2 border border-border hover:border-foreground/30 rounded-full text-xs uppercase tracking-[0.12em] text-foreground/70 transition-colors"
              >
                {{ term | strip }}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{%- if search.performed -%}
  {%- comment -%} Gaveta, auto-envio e aviso de recarga: o mesmo componente da coleção {%- endcomment -%}
  <script src="{{ 'facets.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main_search.name",
  "class": "section-search",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_search.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.settings.layout_header.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12,
      "label": "t:sections.main_search.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main_search.settings.products_per_row.label"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.settings.filters_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_search.settings.filters_paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_search.settings.enable_filtering.label",
      "info": "t:sections.main_search.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_search.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_type_filter",
      "label": "t:sections.main_search.settings.enable_type_filter.label",
      "default": true,
      "info": "t:sections.main_search.settings.enable_type_filter.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_search.settings.no_results_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_suggestions",
      "label": "t:sections.main_search.settings.show_suggestions.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_search.settings.popular_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_popular_searches",
      "label": "t:sections.main_search.settings.show_popular_searches.label",
      "default": true,
      "info": "t:sections.main_search.settings.show_popular_searches.info"
    },
    {
      "type": "text",
      "id": "popular_terms",
      "label": "t:sections.main_search.settings.popular_terms.label",
      "default": "novidades, mais vendidos, promoção, presentes",
      "info": "t:sections.main_search.settings.popular_terms.info"
    }
  ]
}
{% endschema %}
