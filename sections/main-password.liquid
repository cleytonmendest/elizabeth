{%- comment -%}
  A porta da loja protegida por senha. Renderizada por `layout/password.liquid`,
  que não tem header, carrinho nem rodapé — ver o comentário lá.

  Duas coisas que a lojista controla e que não podiam ficar cravadas aqui:

  - A MENSAGEM é `shop.password_message`, que ela escreve no admin (Loja
    virtual → Preferências), não um setting do tema. Sai sem `| escape` de
    propósito: o campo aceita HTML, é ela quem digita, e escapar exibiria as
    tags literais na tela. É o mesmo raciocínio da mensagem de frete grátis.
  - O LOGO vem de `{% render 'logo' %}`, a mesma fonte do cabeçalho. Uma cópia
    aqui divergiria na primeira vez que ela trocasse o SVG pelo PNG.

  A captura de e-mail usa `{% form 'customer' %}` com a tag `newsletter` — o
  mesmo formulário do rodapé, porque é a mesma lista. Sem JavaScript: é um
  POST comum, e a Shopify devolve a página com `form.posted_successfully?`.
  Uma loja que ainda não abriu não tem por que exigir JS para receber um
  e-mail de quem quer ser avisado.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} color-background color-text min-h-screen flex flex-col items-center justify-center">
  <div class="page-width w-full max-w-md text-center !py-16">

    <div class="flex justify-center mb-8">
      {% render 'logo' %}
    </div>

    {%- if shop.password_message != blank -%}
      <div class="text-sm text-foreground/70 mb-8">
        {{ shop.password_message }}
      </div>
    {%- endif -%}

    {%- comment -%} Cadastro de e-mail: aparece ANTES da senha porque é o que a visitante pode fazer. {%- endcomment -%}
    {%- if section.settings.show_signup -%}
      <div class="mb-10">
        <h2 class="text-xs uppercase tracking-label text-foreground/60 mb-4">
          {{ 'general.password_page.signup_heading' | t }}
        </h2>

        {% form 'customer', id: 'password-signup', class: 'flex flex-col gap-2' %}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="text-sm color-success" role="status">{{ 'newsletter.success' | t }}</p>
          {%- else -%}
            {%- if form.errors -%}
              <p class="text-sm color-error" role="alert">{{ 'newsletter.error' | t }}</p>
            {%- endif -%}
            <div class="flex gap-2">
              <label for="PasswordSignupEmail" class="sr-only">{{ 'newsletter.label' | t }}</label>
              <input
                type="email"
                id="PasswordSignupEmail"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="{{ 'newsletter.placeholder' | t | escape }}"
                autocomplete="email"
                required
                class="flex-1 min-w-0 border border-border rounded-theme px-3 py-2.5 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/40"
              >
              <button
                type="submit"
                class="color-button text-xs uppercase tracking-label px-5 py-2.5 rounded-theme hover:opacity-90 transition-opacity"
              >
                {{ 'newsletter.button' | t }}
              </button>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}

    {%- comment -%} A senha em si. {%- endcomment -%}
    <div class="border-t border-border pt-8">
      <h2 class="inline-flex items-center gap-2 text-xs uppercase tracking-label text-foreground/60 mb-4">
        {% render 'icon-lock', size: 14 %}
        {{ 'general.password_page.login_form_heading' | t }}
      </h2>

      {% form 'storefront_password', class: 'flex flex-col gap-2' %}
        {%- if form.errors -%}
          <div class="text-sm color-error mb-1" role="alert">
            <p class="font-medium">{{ 'general.password_page.login_form_error' | t }}</p>
            <div>{{ form.errors | default_errors }}</div>
          </div>
        {%- endif -%}

        <div class="flex gap-2">
          <label for="StorefrontPassword" class="sr-only">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input
            type="password"
            id="StorefrontPassword"
            name="password"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | escape }}"
            autocomplete="current-password"
            required
            class="flex-1 min-w-0 border border-border rounded-theme px-3 py-2.5 text-sm bg-background focus:outline-none focus:ring-2 focus:ring-foreground/40"
          >
          <button
            type="submit"
            class="color-button text-xs uppercase tracking-label px-5 py-2.5 rounded-theme hover:opacity-90 transition-opacity"
          >
            {{ 'general.password_page.login_form_submit' | t }}
          </button>
        </div>
      {% endform %}
    </div>

    <p class="text-xs text-foreground/40 mt-10">
      {{ 'general.password_page.admin_link_html' | t }}
    </p>

  </div>
</div>

{% schema %}
{
  "name": "t:sections.main_password.name",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_password.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "t:sections.main_password.settings.show_signup.label",
      "info": "t:sections.main_password.settings.show_signup.info",
      "default": true
    }
  ]
}
{% endschema %}
