<script src="{{ 'header.js' | asset_url }}" async></script>

{%- liquid
  assign fixed = section.settings.fixed_header

  if fixed
    assign header_type = 'fixed'
  else
    assign header_type = 'basic'
  endif

  case section.settings['menu-type']
    when 'centered-logo-menu-under'
      assign logo_center = true
      assign menu_under = true
      assign search_position = 'left'
      assign search_hidden = false
    when 'logo-left-centered-menu'
      assign logo_center = false
      assign menu_under = false
      assign search_position = 'right'
      assign search_hidden = false
    when 'logo-left-centered-menu-search-hidden'
      assign logo_center = false
      assign menu_under = false
      assign search_position = 'right'
      assign search_hidden = true
    when 'logo-left-menu-under-centered-search'
      assign logo_center = false
      assign menu_under = true
      assign search_position = 'center'
      assign search_hidden = false
    else
      assign logo_center = false
      assign menu_under = true
      assign search_position = 'center'
      assign search_hidden = false
  endcase
-%}

<style>
  {%- if fixed -%}
    #shopify-section-{{ section.id }} {
      position: sticky;
      top: 0;
      z-index: 50;
    }
  {%- endif -%}

  #main-header-container.is-scrolling {
    box-shadow: 0 2px 8px rgb(var(--color-shadow) / 0.1);
  }

  /* ── O modo transparente (issue 121) ───────────────────────────────────────────
   *
   * `data-transparente` é posto por `header.js` e SÓ quando as duas condições
   * valem: a lojista ligou o toggle E a primeira section tem mídia atrás. Sem
   * JavaScript nada disto acontece, e o cabeçalho fica sólido — que é o estado
   * seguro, e por isso é o padrão.
   *
   * A sombra do `is-scrolling` não precisa ser desligada aqui: ela só existe
   * fora do topo, e o transparente só existe NO topo. Os dois são o mesmo
   * interruptor invertido.
   */
  #main-header-container[data-transparente] {
    background-color: transparent;
  }

  /*
   * Submenu aberto devolve o fundo.
   *
   * O painel é sólido e fica logo abaixo da barra. Com a barra transparente
   * sobre a foto e o painel sólido colado nela, o conjunto lê como defeito de
   * renderização — foi um dos cinco que derrubaram a primeira tentativa desta
   * feature.
   */
  #main-header-container[data-transparente]:has(.menu-desk [data-forma]:hover),
  #main-header-container[data-transparente]:has(.menu-desk [data-forma]:focus-within) {
    background-color: rgb(var(--color-background));
  }

  /*
   * O herói sobe para debaixo do cabeçalho.
   *
   * `--header-height` é medida e publicada por `header.js`; sem ela a margem
   * é zero e a página fica exatamente como era. `data-heroi-sob-cabecalho`
   * só é posto quando a transparência foi realmente habilitada, então uma
   * página sem herói nunca é puxada.
   */
  :root[data-heroi-sob-cabecalho] #MainContent > .shopify-section:first-child {
    margin-top: calc(-1 * var(--header-height, 0px));
  }
</style>

<div class="w-full color-{{ section.settings.color_scheme }}">
  <main-header
    class="w-full block relative z-sticky"
    data-type="{{ header_type }}"
    data-transparente="{% if section.settings.transparent_header %}true{% else %}false{% endif %}"
  >
    <div
      id="main-header-container"
      class="color-background color-text w-full transition-shadow duration-300 group relative z-raised"
    >
      <div class="!py-3 page-width w-full">
        <div class="flex justify-between">
          {% if logo_center == false %}
            {% render 'logo' %}
          {% endif %}
          {% if search_position == 'left' and search_hidden == false %}
            {% render 'search-component', flex: 1, large:false %}
          {% endif %}
          {% if logo_center %}
            {% render 'logo' %}
          {% endif %}
          {% if search_position == 'center' and search_hidden == false %}
            {% render 'search-component', flex: 3, large:true %}
          {% endif %}
          {% if menu_under == false %}
            {% render 'main-menu', linklist: section.settings.menu, flex: 5, promo_blocks: section.blocks %}
          {% endif %}
          {% if search_position == 'right' and search_hidden == false %}
            {% render 'search-component', flex: 1.5, showMobile: false, large:false %}
          {% endif %}

          {% render 'header-icons', flex: 1 %}
        </div>
        {% if menu_under %}
          {% render 'main-menu', linklist: section.settings.menu, flex: 1, promo_blocks: section.blocks %}
        {% endif %}
      </div>
    </div>
    {%- comment -%} Overlay da busca preditiva: cobre a página, mas fica atrás do header (z menor que o container) {%- endcomment -%}
    <div class="search-overlay fixed inset-0 bg-foreground/40 z-base hidden"></div>
  </main-header>
</div>

{% schema %}
{
  "name": "t:sections.header.name",
  "tag": "header",
  "class": "header",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.header.settings.color_scheme.label",
      "default": "scheme-1",
      "info": "t:sections.header.settings.color_scheme.info"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:sections.header.settings.menu.label"
    },
    {
      "type": "select",
      "id": "menu-type",
      "label": "t:sections.header.settings.menu_type.label",
      "options": [
        {
          "value": "centered-logo-menu-under",
          "label": "t:sections.header.settings.menu_type.options.centered_logo_menu_under"
        },
        {
          "value": "logo-left-centered-menu",
          "label": "t:sections.header.settings.menu_type.options.logo_left_centered_menu"
        },
        {
          "value": "logo-left-centered-menu-search-hidden",
          "label": "t:sections.header.settings.menu_type.options.logo_left_centered_menu_search_hidden"
        },
        {
          "value": "logo-left-menu-under-centered-search",
          "label": "t:sections.header.settings.menu_type.options.logo_left_menu_under_centered_search"
        }
      ],
      "default": "logo-left-menu-under-centered-search"
    },
    {
      "type": "checkbox",
      "default": true,
      "id": "fixed_header",
      "label": "t:sections.header.settings.fixed_header.label",
      "info": "t:sections.header.settings.fixed_header.info"
    },
    {
      "type": "checkbox",
      "default": false,
      "id": "transparent_header",
      "label": "t:sections.header.settings.transparent_header.label",
      "info": "t:sections.header.settings.transparent_header.info"
    }
  ],
  "blocks": [
    {
      "type": "menu_promo",
      "name": "t:sections.header.blocks.menu_promo.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.header.blocks.menu_promo.paragraph"
        },
        {
          "type": "text",
          "id": "menu_item",
          "label": "t:sections.header.blocks.menu_promo.settings.menu_item.label",
          "info": "t:sections.header.blocks.menu_promo.settings.menu_item.info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.header.blocks.menu_promo.settings.image.label"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.header.blocks.menu_promo.settings.heading.label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.menu_promo.settings.link.label",
          "info": "t:sections.header.blocks.menu_promo.settings.link.info"
        }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
