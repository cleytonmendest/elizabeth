{%- comment -%}
  sections/apps.liquid

  Contêiner para app blocks. Quando o lojista adiciona um bloco de app pelo
  editor, a Shopify escreve uma section do tipo "apps" no template JSON — se o
  tema não tiver este arquivo, a página quebra ao renderizar.

  `templates/product.json` já referenciava esta section sem que ela existisse.
{%- endcomment -%}

<div class="color-{{ section.settings.color_scheme }} color-background color-text">
  <div
    class="page-width"
    style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    {%- for block in section.blocks -%}
      {%- render block -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.apps.name",
  "tag": "section",
  "blocks": [{ "type": "@app" }],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.apps.settings.color_scheme.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.apps.settings.spacing_header.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.apps.settings.padding_top.label",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.apps.settings.padding_bottom.label",
      "default": 24
    }
  ],
  "presets": [{ "name": "t:sections.apps.presets.name" }]
}
{% endschema %}
