{% assign sort_by = collection.sort_by | default: collection.default_sort_by %}
{%- assign products_per_page = section.settings.products_per_page | default: 12 -%}

{%- comment -%} Conta filtros ativos (para "limpar" e estados) — a regra mora em snippets/facets.liquid {%- endcomment -%}
{%- capture active_filter_count -%}{%- render 'facets', part: 'count', filters: collection.filters -%}{%- endcapture -%}
{%- assign active_filter_count = active_filter_count | plus: 0 -%}

{%- comment -%}
  O portador do color scheme é este div EXTERNO, e ele pinta o próprio fundo.
  Juntar portador e `page-width` num elemento só — como era até a #99 — deixa
  o fundo preso à largura do conteúdo: em esquema escuro sobrariam duas faixas
  claras nas laterais. É o mesmo desenho de main-cart, main-search e as outras.
{%- endcomment -%}
<div class="color-{{ section.settings.color_scheme }} color-background color-text">
<div class="page-width !py-8">
  {%- if collection.image and section.settings.show_collection_image -%}
    <div class="collection-hero mb-10 md:mb-12 relative h-64 md:h-[26rem] rounded-theme overflow-hidden">
      <img
        src="{{ collection.image | image_url: width: 1600 }}"
        srcset="{{ collection.image | image_url: width: 600 }} 600w,
                {{ collection.image | image_url: width: 1200 }} 1200w,
                {{ collection.image | image_url: width: 1600 }} 1600w"
        sizes="100vw"
        alt="{{ collection.image.alt | escape }}"
        class="w-full h-full object-cover"
        width="{{ collection.image.width }}"
        height="{{ collection.image.height }}"
        loading="eager"
      >
      <div class="absolute inset-0 bg-black/30 flex flex-col items-center justify-center text-center px-4">
        <h1 class="text-white text-3xl md:text-5xl font-light tracking-title">
          {{ collection.title }}
        </h1>
        {%- if collection.description != blank and section.settings.show_collection_description -%}
          <div class="text-white/80 text-sm md:text-base max-w-2xl mx-auto mt-4">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- else -%}
    <div class="text-center mb-10 md:mb-12">
      <h1 class="text-3xl md:text-4xl font-light tracking-title mb-3">{{ collection.title }}</h1>
      {%- if collection.description != blank and section.settings.show_collection_description -%}
        <div class="text-sm text-foreground-muted max-w-2xl mx-auto">
          {{ collection.description }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- assign show_filters = false -%}
  {%- if section.settings.enable_filtering and collection.filters.size > 0 -%}
    {%- assign show_filters = true -%}
  {%- endif -%}

  {%- capture clear_url -%}{{ collection.url }}{% if sort_by != blank %}?sort_by={{ sort_by }}{% endif %}{%- endcapture -%}

  {%- paginate collection.products by products_per_page -%}
    <facet-filters class="block" data-reload-message="{{ 'collection.general.sort_reloaded' | t | escape }}">
    <form data-filter-form method="get" class="flex flex-col lg:flex-row gap-8">
      {%- if show_filters -%}
        {%- comment -%} Filtros nativos: o mesmo snippet da busca (#141) {%- endcomment -%}
        {%- render 'facets',
          part: 'panel',
          filters: collection.filters,
          active_filter_count: active_filter_count,
          sort_by: sort_by,
          clear_url: clear_url
        -%}
      {%- endif -%}
      {%- comment -%} fim filtros {%- endcomment -%}

      {%- comment -%} Produtos {%- endcomment -%}
      <div class="flex-1">
        {%- comment -%} Barra de ferramentas {%- endcomment -%}
        <div class="grid grid-cols-[1fr_auto_1fr] items-center mb-6 gap-3">
          {%- comment -%} Esquerda: gatilho de filtros (mobile) {%- endcomment -%}
          <div class="justify-self-start">
            {%- if show_filters -%}
              {%- render 'facets', part: 'trigger', active_filter_count: active_filter_count -%}
            {%- endif -%}
          </div>

          {%- comment -%} Centro: contagem de produtos {%- endcomment -%}
          <p class="justify-self-center text-center text-sm text-foreground-muted">
            {%- assign showing_first = paginate.current_offset | plus: 1 -%}
            {%- assign showing_last = paginate.current_offset | plus: paginate.page_size | at_most: paginate.items -%}
            {{ 'collection.general.results_showing' | t: count: paginate.items, first: showing_first, last: showing_last }}
          </p>

          {%- comment -%} Direita: ordenação {%- endcomment -%}
          <div class="justify-self-end flex items-center gap-2">
            {%- if section.settings.enable_sorting -%}
              <label for="SortBy" class="text-sm font-medium hidden sm:inline">{{ 'collection.sorting.title' | t }}</label>
              <select
                id="SortBy"
                name="sort_by"
                class="border border-border rounded-theme px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-foreground/40"
                aria-describedby="a11y-refresh-page-message"
              >
                <option value="manual" {% if sort_by == 'manual' %}selected{% endif %}>{{ 'collection.sorting.featured' | t }}</option>
                <option value="best-selling" {% if sort_by == 'best-selling' %}selected{% endif %}>{{ 'collection.sorting.best_selling' | t }}</option>
                <option value="title-ascending" {% if sort_by == 'title-ascending' %}selected{% endif %}>{{ 'collection.sorting.az' | t }}</option>
                <option value="title-descending" {% if sort_by == 'title-descending' %}selected{% endif %}>{{ 'collection.sorting.za' | t }}</option>
                <option value="price-ascending" {% if sort_by == 'price-ascending' %}selected{% endif %}>{{ 'collection.sorting.price_ascending' | t }}</option>
                <option value="price-descending" {% if sort_by == 'price-descending' %}selected{% endif %}>{{ 'collection.sorting.price_descending' | t }}</option>
                <option value="created-descending" {% if sort_by == 'created-descending' %}selected{% endif %}>{{ 'collection.sorting.date_descending' | t }}</option>
                <option value="created-ascending" {% if sort_by == 'created-ascending' %}selected{% endif %}>{{ 'collection.sorting.date_ascending' | t }}</option>
              </select>
              {%- comment -%} Sem JS a troca não envia sozinha; o form é GET e só precisa de um botão {%- endcomment -%}
              <noscript>
                <button type="submit" class="border border-border rounded-theme px-3 py-2 text-sm">{{ 'collection.filters.apply' | t }}</button>
              </noscript>
            {%- endif -%}
          </div>
        </div>

        {%- if collection.products.size > 0 -%}
          <div
            data-product-grid
            class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-{{ section.settings.products_per_row }} gap-4 md:gap-6"
          >
            {%- for product in collection.products -%}
              {%- render 'card-product-slider',
                card_product: product,
                show_second_image: section.settings.show_second_image,
                show_badges: true,
                lazy_load: true,
                remove_padding: true
              -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <div class="mt-12">
              {%- if section.settings.enable_load_more and paginate.next -%}
                {%- comment -%} Botão "Carregar mais" (JS o revela e esconde a paginação numerada abaixo) {%- endcomment -%}
                <div data-load-more-wrap class="hidden text-center mb-8">
                  <button
                    type="button"
                    data-load-more
                    data-next-url="{{ paginate.next.url }}"
                    class="inline-flex items-center justify-center border border-border rounded-theme px-8 py-3.5 text-xs uppercase tracking-label text-foreground/80 hover:border-foreground/30 transition-colors disabled:opacity-50 disabled:cursor-wait"
                  >
                    {{ 'collection.general.load_more' | t }}
                  </button>
                </div>
              {%- endif -%}
              <div data-pagination>
                {%- render 'pagination', paginate: paginate -%}
              </div>
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="text-center py-20">
            <svg class="w-16 h-16 mx-auto text-foreground/25 mb-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
            </svg>
            {%- if active_filter_count > 0 -%}
              <h2 class="text-2xl font-light tracking-title mb-2">{{ 'collection.general.no_results' | t }}</h2>
              <p class="text-sm text-foreground-muted mb-8">{{ 'collection.general.no_results_text' | t }}</p>
              <a href="{{ collection.url }}" class="inline-flex items-center color-button text-xs uppercase tracking-label px-6 py-3.5 hover:opacity-90 transition-opacity rounded-theme">
                {{ 'collection.filters.clear_all' | t }}
              </a>
            {%- else -%}
              <h2 class="text-2xl font-light tracking-title mb-2">{{ 'collection.general.no_products' | t }}</h2>
              <p class="text-sm text-foreground-muted mb-8">{{ 'collection.general.empty_text' | t }}</p>
              <a href="{{ routes.collections_url }}" class="inline-flex items-center color-button text-xs uppercase tracking-label px-6 py-3.5 hover:opacity-90 transition-opacity rounded-theme">
                {{ 'collection.general.view_all_collections' | t }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </form>
    </facet-filters>
  {%- endpaginate -%}
</div>
</div>

{%- comment -%} Gaveta, auto-envio e aviso de recarga: o mesmo componente da busca {%- endcomment -%}
<script src="{{ 'facets.js' | asset_url }}" defer></script>

<script>
  (function () {
    const root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;

    // "Carregar mais" via Section Rendering API. Progressive enhancement:
    // sem JS, a paginação numerada (fallback) continua funcionando.
    const loadMoreWrap = root.querySelector('[data-load-more-wrap]');
    const grid = root.querySelector('[data-product-grid]');
    if (loadMoreWrap && grid) {
      const btn = loadMoreWrap.querySelector('[data-load-more]');
      const paginationWrap = root.querySelector('[data-pagination]');
      const defaultText = btn.textContent.trim();
      const loadingText = {{ 'general.accessibility.loading' | t | json }};

      loadMoreWrap.classList.remove('hidden');
      if (paginationWrap) paginationWrap.classList.add('hidden');

      btn.addEventListener('click', async () => {
        const url = btn.dataset.nextUrl;
        if (!url) return;
        btn.disabled = true;
        btn.textContent = loadingText;
        try {
          const sep = url.indexOf('?') === -1 ? '?' : '&';
          const res = await fetch(url + sep + 'section_id={{ section.id }}');
          const doc = new DOMParser().parseFromString(await res.text(), 'text/html');

          const newGrid = doc.querySelector('[data-product-grid]');
          if (newGrid) {
            while (newGrid.firstElementChild) grid.appendChild(newGrid.firstElementChild);
          }

          const nextBtn = doc.querySelector('[data-load-more]');
          if (nextBtn && nextBtn.dataset.nextUrl) {
            btn.dataset.nextUrl = nextBtn.dataset.nextUrl;
            btn.disabled = false;
            btn.textContent = defaultText;
          } else {
            loadMoreWrap.remove(); // última página
          }
        } catch (e) {
          console.error('Erro ao carregar mais produtos:', e);
          btn.disabled = false;
          btn.textContent = defaultText;
        }
      });
    }
  })();
</script>

{%- comment -%} SEO: Breadcrumb Schema {%- endcomment -%}
{% render 'schema-breadcrumb', collection: collection %}

{% schema %}
{
  "name": "t:sections.main_collection.name",
  "class": "section-collection",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.main_collection.settings.color_scheme.label",
      "default": "scheme-1",
      "info": "t:sections.main_collection.settings.color_scheme.info"
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.layout_header.content"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12,
      "label": "t:sections.main_collection.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main_collection.settings.products_per_row.label"
    },
    {
      "type": "checkbox",
      "id": "show_second_image",
      "label": "t:sections.main_collection.settings.show_second_image.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.collection_header.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "t:sections.main_collection.settings.show_collection_image.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "t:sections.main_collection.settings.show_collection_description.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_collection.settings.filters_header.content"
    },
    {
      "type": "paragraph",
      "content": "t:sections.main_collection.settings.filters_paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:sections.main_collection.settings.enable_filtering.label",
      "info": "t:sections.main_collection.settings.enable_filtering.info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:sections.main_collection.settings.enable_sorting.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_load_more",
      "label": "t:sections.main_collection.settings.enable_load_more.label",
      "info": "t:sections.main_collection.settings.enable_load_more.info",
      "default": true
    }
  ]
}
{% endschema %}
