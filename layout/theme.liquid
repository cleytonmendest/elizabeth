<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
  <head>
    {% render 'theme-head' %}

    <meta name="theme-color" content="">

    {%- comment -%} Só a vitrine carrega fonte da biblioteca da Shopify. {%- endcomment -%}
    {%- unless settings.type_header_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    {%- comment -%} Literal, e não via snippet: a Shopify exige no arquivo de layout. {%- endcomment -%}
    {{ content_for_header }}

    {% render 'theme-styles' %}

    {% render 'meta-tags' %}

    {%- unless settings.type_body_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      {% comment %}theme-check-disable AssetPreload{% endcomment %}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
      {% comment %}theme-check-enable AssetPreload{% endcomment %}
    {%- endunless -%}

    {%- comment -%} CSS que só a vitrine usa — o carrossel. {%- endcomment -%}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    {{ 'carousel-style.css' | asset_url | stylesheet_tag }}

    <script>
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}',
        cart_url: '{{ routes.cart_url }}',
        predictive_search_url: '{{ routes.predictive_search_url }}',
      };
    </script>

    {%- comment -%} SEO: Organization Schema {%- endcomment -%}
    {% render 'schema-organization' %}
  </head>
  <body>
    {% sections 'header-group' %}
    {% render 'cart-drawer' %}
    <main
      id="MainContent"
      class="content-for-layout focus-none flex flex-col"
      role="main"
      style="gap: var(--spacing-sections)"
      tabindex="-1"
    >
      <div class="page-width py-4 w-full">
        {% render 'breadcrumb' %}
      </div>
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- if settings.show_back_to_top -%}
      {% render 'back-to-top' %}
    {%- endif -%}

    {%- if settings.enable_cookie_banner -%}
      {% render 'cookie-banner' %}
    {%- endif -%}

    <!-- JS Imports -->
    <script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
    <script src="{{ 'carousel-manager.js' | asset_url }}" defer></script>
    <script src="{{ 'search-component.js' | asset_url }}" defer></script>
    <script src="{{ 'price-component.js' | asset_url }}" defer></script>
    <script src="{{ 'variations-selector.js' | asset_url }}" defer></script>
    <script src="{{ 'quantity-selector.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
